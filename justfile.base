######## Tooling versions for Renovate updates ########

# If adding a new docker tool, find the digest for the version you're adding by running e.g.
# docker buildx imagetools inspect kjanat/actionlint:1.17.0

# renovate: datasource=docker depName=kjanat/actionlint versioning=docker
actionlint_version := "1.17.1@sha256:c0a63b3e5c974c2466ead39404b70e448176beaff8c5ec7af0b2e96191aea661"

# renovate: datasource=docker depName=renovate/renovate versioning=docker
renovate_version := "44.175.0@sha256:e9279a5df7697622f880306c84460be14a0492d5dcf5b20cdae1995c836cc4d7"

# renovate: datasource=docker depName=ghcr.io/hadolint/hadolint versioning=docker
hadolint_version := "v2.15.1-alpine@sha256:a1d49ae1a4e83c1dbad26b8c1ad7588c8bd1e04f4866b34ad3cac50335198552"


######## Reusable variables ########
# Run Docker with minimim possible privileges. Note that if you mount any directories in
# you must still ensure these are mounted read-only.
docker_run_safe := 'docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true --user 65534:65534'
